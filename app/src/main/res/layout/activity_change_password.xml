<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/changePasswordContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="250dp"
            android:layout_height="240dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/loginpic"
            android:contentDescription="SmartAgri Logo"
            android:scaleType="fitCenter"/>


        <!-- SmartAGRI Text -->

        <!-- CHANGE PASSWORD Text -->
        <TextView
            android:id="@+id/changePasswordTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHANGE PASSWORD"
            android:textSize="16sp"
            android:textColor="#2D2D2D"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Instructions Text -->
        <TextView
            android:id="@+id/instructionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your new password below."
            android:textSize="14sp"
            android:textColor="#5D5D5D"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Current Password Input -->
        <EditText
            android:id="@+id/currentpasswordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Current Password"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:textColor="#2D2D2D"
            android:textColorHint="#9E9E9E"
            android:background="@drawable/edittext_border"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- New Password Input -->
        <EditText
            android:id="@+id/changenewpasswordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="New Password"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:textColor="#2D2D2D"
            android:textColorHint="#9E9E9E"
            android:background="@drawable/edittext_border"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Confirm New Password Input -->
        <EditText
            android:id="@+id/changeconfirmnewpasswordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Confirm new Password"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:textColor="#2D2D2D"
            android:textColorHint="#9E9E9E"
            android:background="@drawable/edittext_border"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Change Password Button -->
        <Button
            android:id="@+id/changePasswordButton"
            android:layout_width="350dp"
            android:layout_height="56dp"
            android:text="CHANGE PASSWORD"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_rounded"
            android:letterSpacing="0.1"
            android:layout_marginBottom="24dp"/>

        <!-- Back to Settings Text -->
        <TextView
            android:id="@+id/backToSettingsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="Back to Settings"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</ScrollView>