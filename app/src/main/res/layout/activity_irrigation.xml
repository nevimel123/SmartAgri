<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    tools:context=".IrrigationActivity">

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationWrapper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="SmartAGRI"
                android:textColor="@color/primary_gold"
                android:textSize="36sp"
                android:textStyle="bold|italic"
                android:fontFamily="serif"
                android:layout_marginTop="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IRRIGATION"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"/>

            <!-- Metrics Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:weightSum="2"
                android:gravity="center">

                <!-- Moisture Level Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Moisture Level"
                            android:textSize="12sp"
                            android:textColor="@color/text_gray"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvMoistureLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="16%"
                            android:textSize="32sp"
                            android:textColor="@color/primary_gold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Status Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@color/card_pink">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status"
                            android:textSize="12sp"
                            android:textColor="@color/text_gray"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvStatusIrrigation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dry"
                            android:textSize="24sp"
                            android:textColor="@color/status_dry"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Recommended Water -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_light_green">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recommended Water"
                        android:textSize="12sp"
                        android:textColor="@color/primary_green"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvRecommendedWater"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8 L"
                        android:textSize="36sp"
                        android:textColor="@color/primary_green"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Based on soil moisture"
                        android:textSize="10sp"
                        android:textColor="@color/text_gray"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Irrigation Control -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Irrigation Control"
                        android:textSize="16sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif-medium"
                        android:layout_gravity="center_horizontal" />

                    <!-- Water Control with Estimated Duration -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/btnDecrease"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_minus"
                                app:fabSize="normal"
                                app:backgroundTint="@color/primary_pink"
                                app:tint="@color/white"/>

                            <TextView
                                android:id="@+id/tvWaterAmount"
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="8"
                                android:textSize="28sp"
                                android:textColor="@color/text_dark"
                                android:gravity="center"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"/>

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/btnIncrease"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_plus"
                                app:fabSize="normal"
                                app:backgroundTint="@color/primary_green"
                                app:tint="@color/white"/>
                        </LinearLayout>

                        <!-- Estimated Duration -->
                        <TextView
                            android:id="@+id/tvEstimatedDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="~4 min"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Quick Select Buttons -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Select"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"
                        android:layout_marginTop="16dp"
                        android:layout_gravity="center_horizontal"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/btn10L"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+10L"
                            android:layout_marginEnd="8dp"/>

                        <Button
                            android:id="@+id/btn20L"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+20L"
                            android:layout_marginEnd="8dp"/>

                        <Button
                            android:id="@+id/btn30L"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+30L"/>
                    </LinearLayout>

                    <!-- Start Irrigation -->
                    <Button
                        android:id="@+id/btnStartIrrigation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="Start Irrigation"
                        android:background="@drawable/button_rounded"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="vertical"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:alpha="0.2" />

        <!-- Bottom Navigation -->
        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:weightSum="6">

            <!-- Home -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_home"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="HOME"
                    android:textColor="#666666"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Weather -->
            <LinearLayout
                android:id="@+id/navWeather"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_weather"
                   />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="WEATHER"
                    android:textColor="#666666"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- SOS -->
            <LinearLayout
                android:id="@+id/navSOS"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_sos"
                     />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SOS"
                    android:textColor="#666666"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Irrigation -->
            <LinearLayout
                android:id="@+id/navIrrigation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_irrigation"
                    app:tint="@color/green_primary"
                     />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="IRRIGATION"
                    android:textColor="@color/green_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Notify -->
            <LinearLayout
                android:id="@+id/navNotify"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_notification"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="NOTIFY"
                    android:textColor="#666666"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Account -->
            <LinearLayout
                android:id="@+id/navAccount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_account"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ACCOUNT"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
